{
  "name": "pi-vimux-starship",
  "version": "0.1.0-baseline.0",
  "private": true,
  "description": "A Vim- and tmux-inspired command deck for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vim",
    "tmux",
    "cockpit"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "lint": "biome check --config-path=biome.json packages/pi-vim-top-border && eslint packages scripts src test",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test:tooling && npm run test:components",
    "check": "npm run check:baseline && npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:composition && npm run check:openspec",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:composition": "node --import tsx/esm src/local-load-probe.ts",
    "check:openspec": "node scripts/check-openspec.mjs",
    "test:tooling": "node --import tsx/esm --test test/*.test.ts",
    "test:status": "npm --prefix packages/galactica-status test",
    "test:header": "npm --prefix packages/galactica-context-header test",
    "test:footer": "npm --prefix packages/pi-fancy-footer-full-palette test",
    "test:vim": "npm --prefix packages/pi-vim-top-border test",
    "test:components": "npm run test:status && npm run test:header && npm run test:footer && npm run test:vim"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typebox": "1.3.25",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "pi": {
    "extensions": [
      "./packages/pi-fancy-footer-full-palette/src/index.ts",
      "./packages/galactica-status/index.ts",
      "./packages/galactica-context-header/index.ts",
      "./packages/pi-vim-top-border/index.ts"
    ]
  }
}
