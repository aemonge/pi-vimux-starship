{
  "config": {
    "MD013": {
      "line_length": 88,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD004": {
      "style": "dash"
    },
    "MD007": {
      "indent": 2
    },
    "MD010": {
      "code_blocks": false
    },
    "MD012": {
      "maximum": 2
    },
    "MD022": {
      "lines_above": 1,
      "lines_below": 1
    },
    "MD025": true,
    "MD026": true,
    "MD029": {
      "style": "one_or_ordered"
    },
    "MD031": true,
    "MD032": true,
    "MD033": false,
    "MD036": false,
    "MD041": true,
    "MD047": true
  },
  "globs": [
    "**/*.md"
  ]
}
