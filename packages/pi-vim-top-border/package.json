{
  "name": "pi-vim-top-border",
  "version": "0.14.1-local.13",
  "description": "Galactica-managed pi-vim fork with prompt-rail telemetry and icon modes",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vim",
    "editor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lajarre/pi-vim.git"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "echo 'nothing to build'",
    "format": "biome check --write .",
    "lint": "biome check --config-path=../../biome.json . && eslint --config ../../eslint.config.js .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "test:nvim": "node --import tsx/esm --test 'test/nvim-parity*.ts'",
    "test:e2e": "node --import tsx/esm script/image-attachments-e2e.ts",
    "test:smoke": "node --import tsx/esm script/consumer-smoke.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "pack:check": "node --import tsx/esm script/pack-check.ts",
    "scoreboard": "node --import tsx/esm script/scoreboard.ts",
    "hooks:install": "lefthook install",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run pack:check && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": ">=0.74.0"
  }
}
